{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xx505xX505/sana/blob/main/updates/manifest.schema.json",
  "title": "SANA Update Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "channel", "version", "platform", "architecture", "publishedAt", "minimumUpdaterVersion", "releaseNotes", "asset"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "SANA" },
    "channel": { "enum": ["stable", "preview"] },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "platform": { "const": "windows" },
    "architecture": { "enum": ["x64", "arm64"] },
    "publishedAt": { "type": "string", "format": "date-time" },
    "minimumUpdaterVersion": { "type": "string" },
    "releaseNotes": { "type": "string", "format": "uri", "pattern": "^https://" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "sizeBytes", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    }
  }
}
